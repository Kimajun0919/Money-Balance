generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  cash
  savings
  govt_bond
  high_yield_bond
  dividend
  reit
  covered_call
  growth
  alternative
  etc
}

enum RiskTolerance {
  conservative
  moderate
  growth
  aggressive
}

enum AccountType {
  general
  isa
  pension
  irp
  tax_free
  unknown
}

enum PriceChangePeriodType {
  one_month
  three_months
  six_months
  one_year
  since_purchase
  custom
}

enum SuggestionType {
  cash_shortage
  risk_excess
  illusion_warning
  allocation_gap
  return_gap
  maintain
}

enum SuggestionStatus {
  suggested
  viewed
  deferred
  applied
}

enum SnapshotSource {
  manual
  reminder_based
  imported
  broker_sync
  system_generated
}

enum NotificationType {
  monthly_update_request
  cash_shortage
  risk_score_excess
  target_gap_warning
  illusion_warning
  rebalancing_needed
  report_ready
}

enum NotificationPriority {
  low
  medium
  high
  critical
}

enum EmailType {
  monthly_update_reminder
  monthly_report_ready
  cash_shortage_warning
  risk_score_warning
  target_gap_warning
  illusion_warning
}

enum EmailStatus {
  pending
  sent
  failed
  skipped
  mock_sent
}

enum CsvImportStatus {
  uploaded
  parsed
  mapped
  validated
  imported
  failed
  canceled
}

enum CsvRowValidationStatus {
  valid
  warning
  invalid
}

enum CsvImportType {
  standard
  generic
  broker_specific
}

enum DuplicateAssetStatus {
  none
  possible
  confirmed
}

enum ValuationSource {
  manual
  csv_import
  broker_sync
  market_price
  mixed
}

enum ExternalProviderType {
  market_data
  fx_rate
  broker
}

enum ExternalConnectionStatus {
  connected
  disconnected
  failed
  deleted
}

enum ExternalSyncStatus {
  started
  previewed
  applied
  success
  partial_success
  failed
}

enum ExternalSyncType {
  market_price
  fx_rate
  csv_import
  broker_connection
  broker_holdings
  broker_cash
  broker_delete
}

enum MappingSource {
  auto
  user
  system_default
  broker_metadata
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  name                 String?
  target_return        Decimal             @db.Decimal(8, 6)
  risk_tolerance       RiskTolerance
  loss_tolerance       Decimal             @db.Decimal(8, 6)
  risk_score_limit     Int
  min_cash_ratio       Decimal             @db.Decimal(8, 6)
  monthly_investment   Decimal             @db.Decimal(18, 2) @default(0)
  default_account_type AccountType         @default(general)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  assets               Asset[]
  snapshots            PortfolioSnapshot[]
  suggestions          RebalanceSuggestion[]
  monthly_reports      MonthlyReport[]
  monthly_allocation_plans MonthlyAllocationPlan[]
  notifications        Notification[]
  email_logs           EmailLog[]
  notification_settings UserNotificationSetting?
  csv_import_jobs      CsvImportJob[]
  external_connections ExternalConnection[]
  external_sync_logs   ExternalSyncLog[]
  external_asset_mappings ExternalAssetMapping[]

  @@map("users")
}

model Asset {
  id                           String                 @id @default(cuid())
  user_id                      String
  user                         User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  asset_name                   String
  asset_type                   AssetType
  ticker                       String?
  market                       String?
  broker_name                  String?
  account_alias                String?
  external_connection_id       String?
  external_asset_id            String?
  valuation_amount             Decimal                @db.Decimal(18, 2)
  currency                     String                 @default("KRW")
  exchange_rate                Decimal                @db.Decimal(18, 6) @default(1)
  valuation_amount_krw         Decimal                @db.Decimal(18, 2)
  quantity                     Decimal?               @db.Decimal(18, 6)
  purchase_unit_price          Decimal?               @db.Decimal(18, 6)
  purchase_amount              Decimal?               @db.Decimal(18, 2)
  purchase_date                DateTime?
  income_yield                 Decimal                @db.Decimal(8, 6)
  expected_capital_return      Decimal                @db.Decimal(8, 6)
  expected_return              Decimal                @db.Decimal(8, 6)
  price_change_rate            Decimal                @db.Decimal(8, 6) @default(0)
  price_change_period_type     PriceChangePeriodType?
  price_change_start_date      DateTime?
  price_change_end_date        DateTime?
  price_change_rate_annualized Decimal                @db.Decimal(8, 6) @default(0)
  fx_change_rate               Decimal                @db.Decimal(8, 6) @default(0)
  income_tax_rate              Decimal                @db.Decimal(8, 6)
  capital_gain_tax_rate        Decimal                @db.Decimal(8, 6)
  account_type                 AccountType            @default(general)
  risk_level                   String
  risk_coefficient             Decimal                @db.Decimal(8, 6)
  liquidity_level              String
  liquidity_score              Int
  valuation_source             ValuationSource        @default(manual)
  price_source                 String?
  fx_source                    String?
  last_synced_at               DateTime?
  last_price_updated_at        DateTime?
  last_fx_updated_at           DateTime?
  is_auto_imported             Boolean                @default(false)
  user_confirmed_asset_type    Boolean                @default(false)
  created_at                   DateTime               @default(now())
  updated_at                   DateTime               @updatedAt

  @@index([user_id])
  @@index([asset_type])
  @@index([ticker, market])
  @@index([external_connection_id])
  @@map("assets")
}

model TargetAllocationTemplate {
  id                 String                 @id @default(cuid())
  target_return_band Decimal                @db.Decimal(8, 6)
  risk_tolerance     RiskTolerance
  expected_return    Decimal                @db.Decimal(8, 6)
  composition_risk   Int
  template_version   String
  is_active          Boolean                @default(true)
  created_by         String                 @default("seed")
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  items              TargetAllocationItem[]

  @@unique([target_return_band, risk_tolerance, template_version])
  @@map("target_allocation_templates")
}

model TargetAllocationItem {
  id           String                   @id @default(cuid())
  template_id  String
  template     TargetAllocationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  asset_type   AssetType
  target_ratio Decimal                  @db.Decimal(8, 6)
  min_ratio    Decimal                  @db.Decimal(8, 6)
  max_ratio    Decimal                  @db.Decimal(8, 6)
  created_at   DateTime                 @default(now())

  @@unique([template_id, asset_type])
  @@map("target_allocation_items")
}

model PortfolioSnapshot {
  id                         String                  @id @default(cuid())
  user_id                    String
  user                       User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snapshot_date              DateTime
  total_asset_amount_krw     Decimal                 @db.Decimal(18, 2)
  target_return              Decimal                 @db.Decimal(8, 6)
  reference_portfolio_expected_return Decimal        @db.Decimal(8, 6) @default(0)
  portfolio_expected_return  Decimal                 @db.Decimal(8, 6)
  portfolio_income_yield     Decimal                 @db.Decimal(8, 6)
  portfolio_income_amount    Decimal                 @db.Decimal(18, 2)
  monthly_income_amount      Decimal                 @db.Decimal(18, 2)
  after_tax_expected_return  Decimal                 @db.Decimal(8, 6)
  total_return               Decimal                 @db.Decimal(8, 6)
  risk_score                 Decimal                 @db.Decimal(8, 2)
  risk_score_limit           Int
  cash_ratio                 Decimal                 @db.Decimal(8, 6)
  composition_risk           Int
  target_gap                 Decimal                 @db.Decimal(8, 6)
  primary_status             SuggestionType
  active_flags               Json
  snapshot_source            SnapshotSource          @default(manual)
  is_archived                Boolean                 @default(false)
  replaced_by_snapshot_id    String?
  created_at                 DateTime                @default(now())
  items                      PortfolioSnapshotItem[]
  suggestions                RebalanceSuggestion[]

  @@index([user_id, snapshot_date])
  @@map("portfolio_snapshots")
}

model PortfolioSnapshotItem {
  id                String            @id @default(cuid())
  snapshot_id       String
  snapshot          PortfolioSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)
  asset_type        AssetType
  current_amount    Decimal           @db.Decimal(18, 2)
  current_ratio     Decimal           @db.Decimal(8, 6)
  target_ratio      Decimal           @db.Decimal(8, 6)
  target_amount     Decimal           @db.Decimal(18, 2)
  adjustment_amount Decimal           @db.Decimal(18, 2)
  min_ratio         Decimal           @db.Decimal(8, 6) @default(0)
  max_ratio         Decimal           @db.Decimal(8, 6) @default(1)
  allocation_gap_status String        @default("within")
  created_at        DateTime          @default(now())

  @@map("portfolio_snapshot_items")
}

model RebalanceSuggestion {
  id                      String            @id @default(cuid())
  user_id                 String
  user                    User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snapshot_id             String?
  snapshot                PortfolioSnapshot? @relation(fields: [snapshot_id], references: [id], onDelete: SetNull)
  report_id               String?
  suggestion_type         SuggestionType
  target_return           Decimal           @db.Decimal(8, 6)
  current_expected_return Decimal           @db.Decimal(8, 6)
  risk_score              Decimal           @db.Decimal(8, 2)
  cash_ratio              Decimal           @db.Decimal(8, 6)
  summary                 String
  detail                  String
  action_data             Json
  status                  SuggestionStatus  @default(suggested)
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  @@index([user_id, status])
  @@map("rebalance_suggestions")
}

model MonthlyReport {
  id                         String   @id @default(cuid())
  user_id                    String
  user                       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  current_snapshot_id        String
  previous_snapshot_id       String?
  report_month               String
  total_asset_change_amount  Decimal? @db.Decimal(18, 2)
  total_asset_change_rate    Decimal? @db.Decimal(8, 6)
  expected_return_change     Decimal? @db.Decimal(8, 6)
  target_gap_change          Decimal? @db.Decimal(8, 6)
  income_amount_change       Decimal? @db.Decimal(18, 2)
  risk_score_change          Decimal? @db.Decimal(8, 2)
  cash_ratio_change          Decimal? @db.Decimal(8, 6)
  summary                    String
  detail_json                Json
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@index([user_id, report_month])
  @@map("monthly_reports")
}

model MonthlyAllocationPlan {
  id                         String           @id @default(cuid())
  user_id                    String
  user                       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snapshot_id                String?
  monthly_investment_amount  Decimal          @db.Decimal(18, 2)
  cash_first_amount          Decimal          @db.Decimal(18, 2)
  remaining_investment_amount Decimal         @db.Decimal(18, 2)
  allocation_data            Json
  excluded_asset_types       Json
  summary                    String
  status                     SuggestionStatus @default(suggested)
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @updatedAt

  @@index([user_id, status])
  @@map("monthly_allocation_plans")
}

model Notification {
  id         String               @id @default(cuid())
  user_id    String
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  link_url   String
  is_read    Boolean              @default(false)
  priority   NotificationPriority @default(medium)
  created_at DateTime             @default(now())
  read_at    DateTime?

  @@index([user_id, is_read])
  @@map("notifications")
}

model EmailLog {
  id                  String      @id @default(cuid())
  user_id             String
  user                User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email_type          EmailType
  to_email            String
  subject             String
  body_html           String
  body_text           String
  status              EmailStatus @default(pending)
  provider_message_id String?
  error_message       String?
  created_at          DateTime    @default(now())
  sent_at             DateTime?

  @@index([user_id, email_type])
  @@map("email_logs")
}

model UserNotificationSetting {
  id                         String   @id @default(cuid())
  user_id                    String   @unique
  user                       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  in_app_enabled             Boolean  @default(true)
  email_enabled              Boolean  @default(false)
  monthly_update_enabled     Boolean  @default(true)
  monthly_report_enabled     Boolean  @default(true)
  risk_warning_enabled       Boolean  @default(true)
  target_gap_warning_enabled Boolean  @default(true)
  illusion_warning_enabled   Boolean  @default(true)
  update_day_of_month        Int      @default(1)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@map("user_notification_settings")
}

model CsvImportJob {
  id                  String          @id @default(cuid())
  user_id             String
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  filename            String
  import_type         CsvImportType   @default(standard)
  broker_name         String?
  total_rows          Int
  valid_rows          Int
  invalid_rows        Int
  warning_rows        Int
  duplicate_rows      Int             @default(0)
  status              CsvImportStatus @default(uploaded)
  error_summary       String?
  created_snapshot_id String?
  created_at          DateTime        @default(now())
  completed_at        DateTime?
  rows                CsvImportRow[]

  @@index([user_id, status])
  @@map("csv_import_jobs")
}

model CsvImportRow {
  id                String                 @id @default(cuid())
  import_job_id     String
  import_job        CsvImportJob           @relation(fields: [import_job_id], references: [id], onDelete: Cascade)
  row_number        Int
  raw_data          Json
  parsed_data       Json?
  mapped_data       Json?
  validation_status CsvRowValidationStatus
  errors            Json
  warnings          Json
  duplicate_status  DuplicateAssetStatus @default(none)
  duplicate_asset_id String?
  created_asset_id  String?
  created_at        DateTime               @default(now())

  @@index([import_job_id, validation_status])
  @@map("csv_import_rows")
}

model MarketPriceSnapshot {
  id            String   @id @default(cuid())
  ticker        String
  market        String
  currency      String
  price         Decimal  @db.Decimal(18, 6)
  price_date    DateTime
  source        String
  fetched_at    DateTime
  is_delayed    Boolean  @default(true)
  delay_minutes Int      @default(0)
  raw_data      Json?
  created_at    DateTime @default(now())

  @@index([ticker, market, fetched_at])
  @@map("market_price_snapshots")
}

model FxRateSnapshot {
  id             String   @id @default(cuid())
  base_currency  String
  quote_currency String
  rate           Decimal  @db.Decimal(18, 6)
  rate_date      DateTime
  source         String
  fetched_at     DateTime
  is_estimated   Boolean  @default(false)
  raw_data       Json?
  created_at     DateTime @default(now())

  @@index([base_currency, quote_currency, fetched_at])
  @@map("fx_rate_snapshots")
}

model AssetPriceLink {
  id                    String   @id @default(cuid())
  asset_id              String
  ticker                String
  market                String
  price_source          String
  fx_source             String?
  auto_price_enabled    Boolean  @default(true)
  auto_fx_enabled       Boolean  @default(true)
  last_price_updated_at DateTime?
  last_fx_updated_at    DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([asset_id])
  @@index([ticker, market])
  @@map("asset_price_links")
}

model ExternalConnection {
  id                         String                   @id @default(cuid())
  user_id                    String
  user                       User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  provider_type              ExternalProviderType
  provider_name              String
  broker_name                String?
  account_alias              String?
  account_identifier_masked  String?
  encrypted_access_token     String?
  encrypted_refresh_token    String?
  token_preview              String?
  scopes                     Json
  status                     ExternalConnectionStatus @default(connected)
  consent_accepted_at        DateTime?
  last_synced_at             DateTime?
  last_error                 String?
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt
  sync_logs                  ExternalSyncLog[]

  @@index([user_id, provider_type, status])
  @@map("external_connections")
}

model ExternalSyncLog {
  id            String               @id @default(cuid())
  user_id       String
  user          User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  connection_id String?
  connection    ExternalConnection?  @relation(fields: [connection_id], references: [id], onDelete: SetNull)
  provider_type ExternalProviderType
  provider_name String
  sync_type     ExternalSyncType
  status        ExternalSyncStatus
  started_at    DateTime
  completed_at  DateTime?
  total_items   Int                  @default(0)
  success_items Int                  @default(0)
  failed_items  Int                  @default(0)
  warning_items Int                  @default(0)
  error_message String?
  snapshot_id   String?
  raw_summary   Json?

  @@index([user_id, sync_type, status])
  @@index([connection_id])
  @@map("external_sync_logs")
}

model ExternalAssetMapping {
  id                 String        @id @default(cuid())
  user_id            String
  user               User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  provider           String
  external_asset_id  String
  asset_name         String
  ticker             String?
  market             String?
  currency           String
  raw_asset_type     String?
  mapped_asset_type  AssetType
  confidence_score   Decimal       @db.Decimal(8, 6)
  mapping_source     MappingSource
  user_confirmed     Boolean       @default(false)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  @@unique([user_id, provider, external_asset_id])
  @@map("external_asset_mappings")
}

model AssetTypeSetting {
  id                      String    @id @default(cuid())
  asset_type              AssetType @unique
  default_income_yield    Decimal   @db.Decimal(8, 6)
  default_capital_return  Decimal   @db.Decimal(8, 6)
  default_expected_return Decimal   @db.Decimal(8, 6)
  risk_coefficient        Decimal   @db.Decimal(8, 6)
  default_risk_level      String
  default_liquidity_level String
  liquidity_score         Int
  description             String
  is_active               Boolean   @default(true)

  @@map("asset_type_settings")
}

model TaxRateSetting {
  id                    String      @id @default(cuid())
  account_type          AccountType
  asset_type            AssetType
  income_tax_rate       Decimal     @db.Decimal(8, 6)
  capital_gain_tax_rate Decimal     @db.Decimal(8, 6)
  description           String
  is_active             Boolean     @default(true)

  @@unique([account_type, asset_type])
  @@map("tax_rate_settings")
}
