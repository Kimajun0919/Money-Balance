DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yield_balance"

# Phase 3 real provider integration is disabled by default.
# Mock providers work without keys.
MARKET_DATA_PROVIDER="mock"
MARKET_DATA_API_KEY=""
FX_RATE_PROVIDER="mock"
FX_RATE_API_KEY=""
BROKER_PROVIDER="mock"
BROKER_CLIENT_ID=""
BROKER_CLIENT_SECRET=""
TOKEN_ENCRYPTION_SECRET="replace-with-server-side-secret-before-real-broker-use"

# Korea Investment & Securities KIS Open API read-only balance sync.
# Keep real values in .env.local only. Do not expose these values in the browser.
KIS_ENV="real"
KIS_APP_KEY=""
KIS_APP_SECRET=""
KIS_PAPER_APP_KEY=""
KIS_PAPER_APP_SECRET=""
KIS_ACCOUNT_NUMBER=""
KIS_ACCOUNT_PRODUCT_CODE="01"
KIS_ACCOUNT_ALIAS="한국투자 종합계좌"
KIS_ALLOW_NON_LOCAL_SERVER_ROUTES="false"
KIS_SYNC_OVERSEAS="false"
KIS_OVERSEAS_EXCHANGES="NASD"
KIS_OVERSEAS_CURRENCIES="USD"
KIS_DEFAULT_USD_KRW_RATE=""
KIS_DEFAULT_HKD_KRW_RATE=""
KIS_DEFAULT_CNY_KRW_RATE=""
KIS_DEFAULT_JPY_KRW_RATE=""
KIS_DEFAULT_VND_KRW_RATE=""
